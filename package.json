{
  "name": "voxel-sandbox",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "esbuild test/run.ts --bundle --platform=node --format=esm --external:node-web-audio-api --outfile=node_modules/.cache/voxel-test.mjs --log-level=warning && node node_modules/.cache/voxel-test.mjs",
    "bench": "esbuild test/bench.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/voxel-bench.mjs --log-level=warning && node node_modules/.cache/voxel-bench.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.180.0",
    "esbuild": "^0.25.12",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
